# Copy these values to .env.local for local development.
# NEVER commit .env or .env.local to version control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: official campus student email domain restriction (e.g. @coer.ac.in)
ALLOWED_EMAIL_DOMAIN=@coer.ac.in

# CRITICAL SECURITY NOTE:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_ prefix.
# Service role keys bypass all Row Level Security and must ONLY be kept on secure servers.
# SUPABASE_SERVICE_ROLE_KEY=
